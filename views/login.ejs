<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign in — ERP Payroll</title>
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="d-flex align-items-center justify-content-center vh-100 bg-light">
    <div class="card" style="width: 380px">
      <div class="card-body p-4">
        <h4 class="card-title mb-1"><i class="bi bi-calculator text-primary me-2"></i>Sign in</h4>
        <p class="text-muted small mb-4">ERP Payroll — Phase 1</p>

        <% if (error) { %><div class="alert alert-danger py-2 small"><%= error %></div><% } %>

        <form method="POST" action="/login">
          <div class="mb-3">
            <label class="form-label">Username</label>
            <input type="text" name="username" class="form-control" required autofocus />
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" required />
          </div>
          <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>

        <div class="mt-3 pt-3 border-top">
          <p class="text-muted small mb-1"><strong>Demo accounts</strong> (run <code>npm run seed</code> first):</p>
          <p class="text-muted small mb-0">
            admin / admin123 — Super Admin<br />
            companyadmin / admin123 — Company Admin (maker)<br />
            payrollapprover / admin123 — Payroll Approver<br />
            branchuser / admin123 — Branch User (view-only)
          </p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
