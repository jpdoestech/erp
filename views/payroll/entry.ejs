<%- include('../partials/header', { title: entry.last_name + ', ' + entry.first_name }) %>

<div class="page-header flex-wrap">
  <div>
    <span class="eyebrow">Payroll · <%= period.name %> <span class="badge-pill badge-pill--muted"><%= period.status.replace('_',' ') %></span></span>
    <h4 class="mb-0">
      <%= entry.last_name %>, <%= entry.first_name %>
      <span class="badge-pill <%= entry.employee_status === 'ACTIVE' ? 'badge-pill--green' : 'badge-pill--muted' %>"><%= entry.employee_status %></span>
    </h4>
    <p class="text-muted small mb-0 mt-1">
      <%= entry.employee_no %>
      <% if (entry.branch_name) { %> | <%= entry.branch_name %><% } %>
      <% if (entry.client_name) { %> | <%= entry.client_name %><% } %>
      · <%= entry.rate_type %> rate: ₱<%= (entry.rate_amount_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %><%= entry.rate_type === 'DAILY' ? '/day' : '/month' %>
      <% if (!canEdit) { %> · <span class="text-danger">Locked — period is <%= period.status.replace('_',' ') %></span><% } %>
    </p>
  </div>
  <div class="summary-panel">
    <div class="eyebrow mb-2">Summary</div>
    <div class="summary-panel__row">
      <span class="summary-panel__label text-success">Additions</span>
      <span class="money text-success" id="summary-additions">+₱<%= (entry.adjustments_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></span>
    </div>
    <div class="summary-panel__row">
      <span class="summary-panel__label text-danger">Deductions</span>
      <span class="money text-danger">-₱<%= (entry.total_deductions_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></span>
    </div>
    <div class="summary-panel__row summary-panel__row--total">
      <span class="summary-panel__label">Net Pay</span>
      <span class="money fw-bold">₱<%= (entry.net_pay_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></span>
    </div>
  </div>
</div>

<% if (error) { %><div class="alert alert-danger py-2 small"><%= error %></div><% } %>

<ul class="nav nav-tabs mb-3" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#days-tab" type="button" role="tab">
      <i class="bi bi-calendar-week"></i> Days Present
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#additions-tab" type="button" role="tab">
      <i class="bi bi-plus-circle"></i> Other Income / Adjustments
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#deductions-tab" type="button" role="tab">
      <i class="bi bi-dash-circle"></i> Deductions
    </button>
  </li>
</ul>

<div class="tab-content">

  <!-- ===== Days Present (spreadsheet) ===== -->
  <div class="tab-pane fade show active" id="days-tab" role="tabpanel">
    <form id="days-form" method="POST" action="/payroll/<%= period.id %>/entries/<%= entry.id %>/days">
    <div class="card table-responsive">
      <table class="table table-hover mb-0 align-middle spreadsheet-table">
        <thead>
          <tr>
            <th class="ps-3" rowspan="2" style="vertical-align:bottom;">Type of Day</th>
            <th colspan="3" class="text-center group-header">Days / Hours</th>
            <th colspan="4" class="text-center group-header">Amounts</th>
          </tr>
          <tr>
            <th class="text-end" style="width:90px;">Days</th>
            <th class="text-end" style="width:90px;">OT Hrs</th>
            <th class="text-end" style="width:90px;">ND Hrs</th>
            <th class="text-end">Day Pay</th>
            <th class="text-end">OT Pay</th>
            <th class="text-end">ND Pay</th>
            <th class="text-end pe-3">Row Total</th>
          </tr>
        </thead>
        <tbody>
          <% dayRows.forEach(function(r) { %>
            <tr class="<%= r.rowTotal === 0 ? 'text-muted' : '' %>" data-row-key="<%= r.key %>">
              <td class="ps-3 fw-medium"><%= r.label %></td>
              <td class="text-end">
                <% if (canEdit) { %>
                  <input type="number" step="0.0001" min="0" name="<%= r.key %>_days" value="<%= r.dayQty %>" class="form-control form-control-sm text-end d-inline-block day-input" style="width:85px;" />
                <% } else { %><%= r.dayQty %><% } %>
              </td>
              <td class="text-end">
                <% if (canEdit) { %>
                  <input type="number" step="0.0001" min="0" name="<%= r.key %>_ot" value="<%= r.otQty %>" class="form-control form-control-sm text-end d-inline-block day-input" style="width:85px;" />
                <% } else { %><%= r.otQty %><% } %>
              </td>
              <td class="text-end">
                <% if (canEdit) { %>
                  <input type="number" step="0.0001" min="0" name="<%= r.key %>_nd" value="<%= r.ndQty %>" class="form-control form-control-sm text-end d-inline-block day-input" style="width:85px;" />
                <% } else { %><%= r.ndQty %><% } %>
              </td>
              <td class="text-end money" data-cell="dayPay">₱<%= (r.dayAmount / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
              <td class="text-end money" data-cell="otPay">₱<%= (r.otAmount / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
              <td class="text-end money" data-cell="ndPay">₱<%= (r.ndAmount / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
              <td class="text-end money fw-medium pe-3" data-cell="rowTotal">₱<%= (r.rowTotal / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot>
          <tr class="totals-row">
            <td class="ps-3">Total</td>
            <td class="text-end money" data-total="days"><%= dayTotals.days %></td>
            <td class="text-end money" data-total="ot"><%= dayTotals.ot %></td>
            <td class="text-end money" data-total="nd"><%= dayTotals.nd %></td>
            <td class="text-end money" data-total="dayPay">₱<%= (dayTotals.dayPay / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
            <td class="text-end money" data-total="otPay">₱<%= (dayTotals.otPay / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
            <td class="text-end money" data-total="ndPay">₱<%= (dayTotals.ndPay / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
            <td class="text-end money pe-3" data-total="rowTotal">₱<%= (dayTotals.rowTotal / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
    <% if (canEdit) { %>
      <div class="d-flex align-items-center gap-2 mt-2">
        <button type="submit" class="btn btn-primary btn-sm" id="save-days-btn"><i class="bi bi-check2"></i> Save Changes</button>
        <span class="text-muted small" id="unsaved-indicator" style="display:none;">Unsaved changes</span>
      </div>
    <% } %>
    </form>
    <p class="hint mt-2">
      Each row's rate already reflects the DOLE-mandated combined multiplier for that day type
      (e.g. Special Holiday on a Rest Day is 150%, not 130% + 130%).
      <% if (canEdit) { %>
        Days/OT/ND accept up to 4 decimal places (e.g. 9.375 for a partial day). Amounts update
        live as you type; nothing is saved until you click Save Changes.
      <% } %>
      Standard defaults, not a certified compliance engine.
    </p>
  </div>

  <script>
    var ROW_DEFS = <%- rowDefsJson %>;
    var DAILY_RATE_CENTS = <%= entry.rate_type === 'MONTHLY' ? entry.rate_amount_cents / 26 : entry.rate_amount_cents %>;
    var HOURLY_RATE_CENTS = DAILY_RATE_CENTS / 8;

    function pesos(cents) {
      return '₱' + (cents / 100).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    function roundCents(n) { return Math.round(n); }

    var daysForm = document.getElementById('days-form');
    var dirty = false;

    function markDirty() {
      dirty = true;
      var ind = document.getElementById('unsaved-indicator');
      if (ind) ind.style.display = 'inline';
    }

    function recalcAll() {
      var totals = { days: 0, ot: 0, nd: 0, dayPay: 0, otPay: 0, ndPay: 0, rowTotal: 0 };
      ROW_DEFS.forEach(function (rd) {
        var row = daysForm.querySelector('tr[data-row-key="' + rd.key + '"]') ||
          document.querySelector('tr[data-row-key="' + rd.key + '"]');
        if (!row) return;
        var daysInput = row.querySelector('[name="' + rd.key + '_days"]');
        var otInput = row.querySelector('[name="' + rd.key + '_ot"]');
        var ndInput = row.querySelector('[name="' + rd.key + '_nd"]');
        var days = daysInput ? (parseFloat(daysInput.value) || 0) : 0;
        var ot = otInput ? (parseFloat(otInput.value) || 0) : 0;
        var nd = ndInput ? (parseFloat(ndInput.value) || 0) : 0;

        var dayPay = roundCents(DAILY_RATE_CENTS * rd.dayMult * days);
        var otPay = roundCents(HOURLY_RATE_CENTS * rd.otMult * ot);
        var ndPay = roundCents(HOURLY_RATE_CENTS * rd.ndMult * nd);
        var rowTotal = dayPay + otPay + ndPay;

        var dayCell = row.querySelector('[data-cell="dayPay"]');
        var otCell = row.querySelector('[data-cell="otPay"]');
        var ndCell = row.querySelector('[data-cell="ndPay"]');
        var totalCell = row.querySelector('[data-cell="rowTotal"]');
        if (dayCell) dayCell.textContent = pesos(dayPay);
        if (otCell) otCell.textContent = pesos(otPay);
        if (ndCell) ndCell.textContent = pesos(ndPay);
        if (totalCell) totalCell.textContent = pesos(rowTotal);
        row.classList.toggle('text-muted', rowTotal === 0);

        totals.days += days;
        totals.ot += ot;
        totals.nd += nd;
        totals.dayPay += dayPay;
        totals.otPay += otPay;
        totals.ndPay += ndPay;
        totals.rowTotal += rowTotal;
      });

      var footer = daysForm.querySelector('tfoot');
      if (footer) {
        var fmt4 = function (n) {
          return (Math.round(n * 10000) / 10000).toString();
        };
        footer.querySelector('[data-total="days"]').textContent = fmt4(totals.days);
        footer.querySelector('[data-total="ot"]').textContent = fmt4(totals.ot);
        footer.querySelector('[data-total="nd"]').textContent = fmt4(totals.nd);
        footer.querySelector('[data-total="dayPay"]').textContent = pesos(totals.dayPay);
        footer.querySelector('[data-total="otPay"]').textContent = pesos(totals.otPay);
        footer.querySelector('[data-total="ndPay"]').textContent = pesos(totals.ndPay);
        footer.querySelector('[data-total="rowTotal"]').textContent = pesos(totals.rowTotal);
      }
      markDirty();
    }

    if (daysForm) {
      daysForm.querySelectorAll('.day-input').forEach(function (el) {
        el.addEventListener('input', recalcAll);
      });
      daysForm.addEventListener('submit', function () {
        dirty = false;
      });
    }

    window.addEventListener('beforeunload', function (e) {
      if (!dirty) return;
      e.preventDefault();
      e.returnValue = '';
    });

    document.querySelectorAll('.leave-guard').forEach(function (a) {
      a.addEventListener('click', function (e) {
        if (dirty && !confirm('You have unsaved changes on this page. Leave without saving?')) {
          e.preventDefault();
        }
      });
    });
  </script>

  <!-- ===== Other Income / Adjustments ===== -->
  <div class="tab-pane fade" id="additions-tab" role="tabpanel">
    <div class="card">
      <table class="table table-hover mb-0">
        <thead><tr><th class="ps-3">Description</th><th class="text-end">Amount</th><% if (canEdit) { %><th class="table-actions pe-3">Actions</th><% } %></tr></thead>
        <tbody>
          <% adjustments.forEach(function(a) { %>
            <tr>
              <td class="ps-3"><%= a.description %></td>
              <td class="text-end money">₱<%= (a.amount_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
              <% if (canEdit) { %>
                <td class="table-actions pe-3">
                  <form method="POST" action="/payroll/<%= period.id %>/entries/<%= entry.id %>/adjustments/<%= a.id %>/delete" class="d-inline">
                    <button class="row-action-link row-action-link--danger" type="submit" onclick="return confirm('Remove this addition?')">Remove</button>
                  </form>
                </td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <% if (adjustments.length === 0) { %>
        <div class="empty-state"><i class="bi bi-plus-circle"></i>No additions yet — allowances, reimbursements, or one-off bonuses go here.</div>
      <% } %>
      <% if (canEdit) { %>
        <div class="p-3 border-top">
          <div class="eyebrow mb-2">Add an item</div>
          <form method="POST" action="/payroll/<%= period.id %>/entries/<%= entry.id %>/adjustments" class="row g-2 align-items-end">
            <div class="col-auto">
              <label class="form-label">Description</label>
              <input type="text" name="description" class="form-control form-control-sm" style="width:260px;" maxlength="200" required />
            </div>
            <div class="col-auto">
              <label class="form-label">Amount (₱)</label>
              <input type="number" step="0.01" min="0.01" name="amount" class="form-control form-control-sm" style="width:120px;" required />
            </div>
            <div class="col-auto"><button class="btn btn-primary btn-sm" type="submit">Add</button></div>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <!-- ===== Deductions ===== -->
  <div class="tab-pane fade" id="deductions-tab" role="tabpanel">
    <div class="card p-3 mb-3">
      <div class="eyebrow mb-2">Loan / Cash Advance Deductions</div>
      <table class="table table-hover mb-0">
        <thead><tr><th class="ps-3">Loan</th><th class="text-end">Amount</th><% if (canEdit) { %><th class="table-actions pe-3">Actions</th><% } %></tr></thead>
        <tbody>
          <% loanDeductions.forEach(function(d) { %>
            <tr>
              <td class="ps-3 fw-medium">
                <a href="/loans/<%= d.loan_id %>"><%= loanTypes[d.loan_type] || d.loan_type %></a>
                <% if (d.loan_description) { %><span class="text-muted small"> — <%= d.loan_description %></span><% } %>
              </td>
              <td class="text-end money">₱<%= (d.amount_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
              <% if (canEdit) { %>
                <td class="table-actions pe-3">
                  <form method="POST" action="/payroll/<%= period.id %>/entries/<%= entry.id %>/loan-deductions/<%= d.id %>/delete" class="d-inline">
                    <button class="row-action-link row-action-link--danger" type="submit" onclick="return confirm('Remove this loan deduction? It will be added back to the loan balance.')">Remove</button>
                  </form>
                </td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <% if (loanDeductions.length === 0) { %>
        <div class="empty-state"><i class="bi bi-wallet2"></i>No loan deductions applied yet.</div>
      <% } %>
      <% if (canEdit) { %>
        <div class="pt-3 border-top mt-2">
          <% if (availableLoans.length === 0) { %>
            <p class="text-muted small mb-0">This employee has no active loans with a remaining balance. <a href="/loans/new">Create one</a> if needed.</p>
          <% } else { %>
            <div class="eyebrow mb-2">Apply a deduction</div>
            <form method="POST" action="/payroll/<%= period.id %>/entries/<%= entry.id %>/loan-deductions" class="row g-2 align-items-end">
              <div class="col-auto">
                <label class="form-label">Loan</label>
                <select name="loan_id" class="form-select form-select-sm" style="min-width:280px;" required>
                  <% availableLoans.forEach(function(l) { %>
                    <option value="<%= l.id %>">
                      <%= loanTypes[l.loan_type] || l.loan_type %><% if (l.description) { %> — <%= l.description %><% } %>
                      (balance ₱<%= (l.balance_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %>)
                    </option>
                  <% }); %>
                </select>
              </div>
              <div class="col-auto">
                <label class="form-label">Amount (₱)</label>
                <input type="number" step="0.01" min="0.01" name="amount" class="form-control form-control-sm" style="width:120px;" required />
              </div>
              <div class="col-auto"><button class="btn btn-primary btn-sm" type="submit">Apply</button></div>
            </form>
            <p class="hint mt-2">Amount cannot exceed the loan's remaining balance. Removing a deduction restores it to the balance.</p>
          <% } %>
        </div>
      <% } %>
    </div>

    <div class="card p-3">
      <div class="eyebrow mb-2">Statutory Deductions (auto-computed)</div>
      <p class="text-muted small mb-2">
        Based on this entry's gross pay, scaled to a monthly-equivalent using the period's
        <strong><%= period.pay_frequency.replace('_',' ') %></strong> frequency, then scaled back down.
        Standard 2025–2026 rates — verify against SSS/PhilHealth/Pag-IBIG/BIR; not a certified compliance engine.
      </p>
      <table class="table mb-0" style="max-width:480px;">
        <thead><tr><th>Deduction</th><th class="text-end">Employee Share</th><th class="text-end">Employer Share</th></tr></thead>
        <tbody>
          <tr><td>SSS</td><td class="text-end money">₱<%= (entry.sss_employee_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td><td class="text-end money text-muted">₱<%= (entry.sss_employer_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td></tr>
          <tr><td>PhilHealth</td><td class="text-end money">₱<%= (entry.philhealth_employee_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td><td class="text-end money text-muted">₱<%= (entry.philhealth_employer_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td></tr>
          <tr><td>Pag-IBIG</td><td class="text-end money">₱<%= (entry.pagibig_employee_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td><td class="text-end money text-muted">₱<%= (entry.pagibig_employer_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td></tr>
          <tr><td>Withholding Tax</td><td class="text-end money">₱<%= (entry.withholding_tax_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td><td class="text-end text-muted">—</td></tr>
          <tr><td>Loan / Cash Advance</td><td class="text-end money">₱<%= (entry.loan_deduction_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td><td class="text-end text-muted">—</td></tr>
          <tr class="totals-row"><td>Total Deductions</td><td class="text-end money">₱<%= (entry.total_deductions_cents / 100).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td><td></td></tr>
        </tbody>
      </table>
    </div>
  </div>

</div>

<div class="mt-3 d-flex justify-content-between align-items-center">
  <a href="/payroll/<%= period.id %>" class="leave-guard"><i class="bi bi-arrow-left"></i> Back to <%= period.name %></a>
  <a href="/payroll/<%= period.id %>/entries/<%= entry.id %>/payslip.pdf" target="_blank" class="btn btn-outline-primary btn-sm">
    <i class="bi bi-file-earmark-pdf"></i> Download Payslip (PDF)
  </a>
</div>

<%- include('../partials/footer') %>
