<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>ERP Payroll</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<% function isActive(path) { return typeof currentPath !== 'undefined' && currentPath.startsWith(path) ? 'is-active' : ''; } %>
<% if (currentUser) { %>
<div class="app-shell">
  <aside class="app-sidebar">
    <div class="app-sidebar__brand"><i class="bi bi-cash-coin"></i><span>ERP · Payroll</span></div>
    <nav class="pb-4">
      <a href="/" class="app-sidebar__link <%= isActive('/dashboard') || currentPath === '/' ? 'is-active' : '' %>">
        <i class="bi bi-speedometer2"></i> Dashboard
      </a>

      <% if (['SUPER_ADMIN','COMPANY_ADMIN','BRANCH_USER'].includes(currentUser.role)) { %>
        <div class="app-sidebar__section">Structure</div>
        <% if (currentUser.role === 'SUPER_ADMIN') { %>
          <a href="/companies" class="app-sidebar__link <%= isActive('/companies') %>">
            <i class="bi bi-building"></i> Companies
          </a>
        <% } %>
        <a href="/branches" class="app-sidebar__link <%= isActive('/branches') %>">
          <i class="bi bi-diagram-3"></i> Branches
        </a>
        <a href="/clients" class="app-sidebar__link <%= isActive('/clients') %>">
          <i class="bi bi-briefcase"></i> Clients
        </a>

        <div class="app-sidebar__section">Workforce</div>
        <a href="/employees" class="app-sidebar__link <%= isActive('/employees') %>">
          <i class="bi bi-people"></i> Employees
        </a>
      <% } %>

      <div class="app-sidebar__section">Payroll</div>
      <a href="/payroll" class="app-sidebar__link <%= isActive('/payroll') %>">
        <i class="bi bi-cash-stack"></i> Payroll Periods
      </a>
    </nav>
  </aside>

  <div class="flex-grow-1 d-flex flex-column">
    <header class="app-topbar">
      <div class="ms-auto d-flex align-items-center gap-3">
        <span class="text-muted small"><%= currentUser.full_name %> · <%= currentUser.role.replace('_',' ') %></span>
        <form method="POST" action="/logout" class="mb-0">
          <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-box-arrow-right"></i> Log out</button>
        </form>
      </div>
    </header>
    <main class="app-main flex-grow-1">
<% } %>
