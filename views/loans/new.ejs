<%- include('../partials/header', { title: 'New Loan' }) %>

<div class="page-header"><div><span class="eyebrow">Workforce</span><h4 class="mb-0">New Loan / Cash Advance</h4></div></div>

<div class="card p-4" style="max-width:520px;">
  <% if (error) { %><div class="alert alert-danger py-2 small"><%= error %></div><% } %>
  <form method="POST" action="/loans">
    <% if (companies) { %>
      <div class="mb-3">
        <label class="form-label">Company</label>
        <select name="company_id" class="form-select" required>
          <option value="">— Select —</option>
          <% companies.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= (selectedCompanyId && Number(selectedCompanyId) === c.id) ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
      </div>
    <% } %>
    <div class="mb-3">
      <label class="form-label">Employee</label>
      <select name="employee_id" class="form-select" required>
        <option value="">— Select —</option>
        <% employees.forEach(function(e) { %>
          <option value="<%= e.id %>" <%= values.employee_id == e.id ? 'selected' : '' %>><%= e.last_name %>, <%= e.first_name %> (<%= e.employee_no %>)</option>
        <% }); %>
      </select>
      <% if (employees.length === 0 && selectedCompanyId) { %>
        <div class="hint">No active employees found for this company.</div>
      <% } %>
    </div>
    <div class="mb-3">
      <label class="form-label">Loan Type</label>
      <select name="loan_type" class="form-select" required>
        <% Object.keys(loanTypes).forEach(function(key) { %>
          <option value="<%= key %>" <%= values.loan_type === key ? 'selected' : '' %>><%= loanTypes[key] %></option>
        <% }); %>
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label">Description (optional)</label>
      <input type="text" name="description" class="form-control" value="<%= values.description || '' %>" maxlength="200" placeholder="e.g. Emergency cash advance, Aug 2026" />
    </div>
    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <label class="form-label">Principal Amount (₱)</label>
        <input type="number" step="0.01" min="0.01" name="principal" class="form-control" value="<%= values.principal || '' %>" required />
      </div>
      <div class="col-md-6">
        <label class="form-label">Installment per Period (₱)</label>
        <input type="number" step="0.01" min="0.01" name="installment" class="form-control" value="<%= values.installment || '' %>" required />
        <div class="hint">Suggested deduction amount when applying this loan to a payroll entry — the actual amount can be adjusted per period, up to the remaining balance.</div>
      </div>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-primary btn-sm" type="submit">Create Loan</button>
      <a class="btn btn-outline-secondary btn-sm" href="/loans">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
