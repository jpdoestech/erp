<%- include('../partials/header', { title: 'New Branch' }) %>

<div class="page-header"><div><span class="eyebrow">Structure</span><h4 class="mb-0">New Branch</h4></div></div>

<div class="card p-4" style="max-width:480px;">
  <% if (error) { %><div class="alert alert-danger py-2 small"><%= error %></div><% } %>
  <form method="POST" action="/branches">
    <% if (companies) { %>
      <div class="mb-3">
        <label class="form-label">Company</label>
        <select name="company_id" class="form-select" required>
          <option value="">— Select —</option>
          <% companies.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= (selectedCompanyId && Number(selectedCompanyId) === c.id) ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
      </div>
    <% } %>
    <div class="mb-3">
      <label class="form-label">Branch Code</label>
      <input type="text" name="code" class="form-control" value="<%= values.code || '' %>" required maxlength="20" />
    </div>
    <div class="mb-3">
      <label class="form-label">Branch Name</label>
      <input type="text" name="name" class="form-control" value="<%= values.name || '' %>" required maxlength="120" />
    </div>
    <div class="mb-3">
      <label class="form-label">Head Office (label)</label>
      <input type="text" name="head_office" class="form-control" value="<%= values.head_office || '' %>" maxlength="120" />
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-primary btn-sm" type="submit">Create Branch</button>
      <a class="btn btn-outline-secondary btn-sm" href="/branches">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
